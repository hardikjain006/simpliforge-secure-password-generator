#!/usr/bin/env python3
"""Secure password generator: one input mode, one output mode.

Public contract is defined in README.md (sections 2-7).
Input: command-line arguments only (`--length <n>`, `-h`/`--help`).
Output: generated password on standard output only.
"""

import re
import secrets
import sys

ALPHABET = (
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    "abcdefghijklmnopqrstuvwxyz"
    "0123456789"
    "!@#$%^&*()-_=+"
)

DEFAULT_LENGTH = 16
MIN_LENGTH = 8
MAX_LENGTH = 128

HELP_TEXT = """usage: secure-password-generator [--length <n>]
       secure-password-generator [-h | --help]

Generate one secure random password.

Options:
  --length <n>  Password length as a decimal integer between 8 and 128
                (default: 16). Only the space-separated form is accepted.
  -h, --help    Show this help and exit.

Output:
  On success, print the generated password on standard output followed
  by a single newline. No other output is written to standard output.

Examples:
  secure-password-generator
  secure-password-generator --length 16
  secure-password-generator --length 32
"""

_LENGTH_RE = re.compile(r"-?[0-9]+\Z")


def _error(message):
    sys.stderr.write(message + "\n")


def _sanitize(token):
    return token.replace("\r", "\\r").replace("\n", "\\n")


def main(argv):
    consumed = set()
    length_occurrences = []
    for i, token in enumerate(argv):
        if i in consumed:
            continue
        if token == "--length":
            if i + 1 < len(argv):
                consumed.add(i + 1)
                length_occurrences.append((i, argv[i + 1], False))
            else:
                length_occurrences.append((i, None, True))

    for i, token in enumerate(argv):
        if token in ("-h", "--help") and i not in consumed:
            sys.stdout.write(HELP_TEXT)
            return 0

    if len(length_occurrences) > 1:
        _error("error: --length supplied more than once")
        return 2

    length = DEFAULT_LENGTH
    if length_occurrences:
        _, value, missing = length_occurrences[0]
        if missing:
            _error(
                "error: missing value for --length:"
                " expected an integer between 8 and 128"
            )
            return 2
        if not _LENGTH_RE.match(value):
            _error(
                "error: non-integer length '%s':"
                " expected an integer between 8 and 128" % _sanitize(value)
            )
            return 2
        length = int(value, 10)
        if length < MIN_LENGTH or length > MAX_LENGTH:
            _error(
                "error: out-of-range length '%s':"
                " accepted range is 8-128" % _sanitize(value)
            )
            return 2

    if length_occurrences:
        option_index = length_occurrences[0][0]
        value_index = option_index + 1
        for i, token in enumerate(argv):
            if i in (option_index, value_index):
                continue
            if token.startswith("-") and token != "":
                _error("error: unknown option '%s'" % _sanitize(token))
            else:
                _error(
                    "error: unknown option or unexpected argument"
                    " '%s'" % _sanitize(token)
                )
            return 2
    else:
        if len(argv) > 0:
            token = argv[0]
            if token.startswith("-") and token != "":
                _error("error: unknown option '%s'" % _sanitize(token))
            else:
                _error(
                    "error: unknown option or unexpected argument"
                    " '%s'" % _sanitize(token)
                )
            return 2

    password = "".join(secrets.choice(ALPHABET) for _ in range(length))
    sys.stdout.write(password + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
